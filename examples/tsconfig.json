{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@kronos-ts/core": [
        "../../kronos-ts/packages/core/src/index.ts"
      ],
      "@kronos-ts/test": [
        "../../kronos-ts/packages/test/src/index.ts"
      ],
      "@kronos-ts/postgres": [
        "../../kronos-ts/packages/postgres/src/index.ts"
      ],
      "@kronos-ts/postgres/adapters/*": [
        "../../kronos-ts/packages/postgres/src/adapters/*.ts"
      ],
      "@kronos-ts/drizzle": [
        "../../kronos-ts/packages/drizzle/src/index.ts"
      ],
      "@kronos-ts/knex": [
        "../../kronos-ts/packages/knex/src/index.ts"
      ],
      "@kronos-ts/kysely": [
        "../../kronos-ts/packages/kysely/src/index.ts"
      ],
      "@kronos-ts/prisma": [
        "../../kronos-ts/packages/prisma/src/index.ts"
      ],
      "@kronos-ts/typeorm": [
        "../../kronos-ts/packages/typeorm/src/index.ts"
      ],
      "@kronos-ts/kronosdb": [
        "../../kronos-ts/packages/kronosdb/src/index.ts"
      ],
      "@kronos-ts/rabbitmq": [
        "../../kronos-ts/packages/rabbitmq/src/index.ts"
      ],
      "@kronos-ts/axon-server": [
        "../../kronos-ts/packages/axon-server/src/index.ts"
      ],
      "@kronos-ts/otlp": [
        "../../kronos-ts/packages/otlp/src/index.ts"
      ],
      "drizzle-orm": [
        "../../kronos-ts/packages/drizzle/node_modules/drizzle-orm/index.d.ts"
      ],
      "drizzle-orm/*": [
        "../../kronos-ts/packages/drizzle/node_modules/drizzle-orm/*"
      ],
      "pg": [
        "../../kronos-ts/node_modules/.bun/@types+pg@8.20.0/node_modules/@types/pg/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
